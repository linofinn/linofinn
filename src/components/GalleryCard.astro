---
interface Props {

title: string;

image: string;

slug: string;

}

const { title, image, slug } = Astro.props;
---

<article class="gallery-card">

<a href={`/gallery/${slug}`}>

    <img

        src={image}

        alt={title}

    />

</a>

<div class="gallery-links">

    <a href={`/gallery/${slug}`}>

        [ Details ]

    </a>

    <a href="#">

        [ Request Print ]

    </a>

</div>

</article>