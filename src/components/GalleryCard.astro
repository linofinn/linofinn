---
interface Props {
    title: string;
    slug: string;
}

const { title, slug } = Astro.props;
---

<article class="gallery-card">

    <a href={`/gallery/${slug}`}>

        <img
            src={`/prints/${slug}/${slug}.jpg`}
            alt={title}
        />

    </a>

    <nav class="gallery-links">

        <a
            class="bracket-link details-link"
            href={`/gallery/${slug}`}
        >
            Details
        </a>

    </nav>

</article>