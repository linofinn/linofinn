---
import Container from "./Container.astro";
---

<Container>

<header>

    <a href="/" class="logo">

        LINO<br>
        FINN

    </a>

    <nav>

        <a href="/gallery">Gallery</a>

        <a href="/about">Studio</a>

        <a href="/contact">Contact</a>

    </nav>

</header>

</Container>

<style>

header {

    display:flex;

    justify-content:space-between;

    align-items:flex-start;

    padding:2rem 0;

}

.logo{

    font-family:"Martian Mono";

    font-weight:700;

    line-height:.95;

    font-size:1.2rem;

}

nav{

    display:flex;

    gap:2rem;

}

nav a{

    opacity:.7;

    transition:.2s;

}

nav a:hover{

    color:var(--accent);

    opacity:1;

}

</style>
