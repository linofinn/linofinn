---
import { getCollection } from "astro:content";
import InquiryForm from "../../components/InquiryForm.astro";
import Layout from "../../layouts/Layout.astro";
import BottomNav from "../../components/BottomNav.astro";

export async function getStaticPaths() {
    const prints = await getCollection("prints");

    return prints.map((print) => ({
        params: {
            slug: print.id,
        },
        props: {
            print,
        },
    }));
}

const { print } = Astro.props;
---

<Layout
    image={`/prints/${print.id}/${print.id}.jpg`}
    title="LINO FINN"
/>

    <div class="print-layout">

        <header class="print-header">

            <a href="/" class="wordmark">
                LINO FINN
            </a>

            <p class="site-tagline">
                Original relief prints <span>for the people.</span>
            </p>

        </header>

        <main class="print-page">

            <img
                class="print-image"
                src={`/prints/${print.id}/${print.id}.jpg`}
                alt={print.data.title}
            />

            <div class="print-details">

                <p><span class="label">YEAR</span> {print.data.year}</p>

                <p><span class="label">DIMENSIONS</span> {print.data.dimensions}</p>

                <p><span class="label">PAPER</span> {print.data.paper}</p>

                <p><span class="label">EDITION</span> {print.data.edition}</p>

                <p>

                    <span class="label">STATUS</span>
                
                    <span class={print.data.available ? "status-available" : "status-unavailable"}>
                
                        {print.data.available ? "Available" : "Unavailable"}
                
                    </span>
                
                </p>

            </div>

            {
                print.data.available && (
            
                    <div class="print-actions">
            
                        <button
                            id="show-form"
                            class="bracket-link"
                            type="button"
                        >
                            Request Print
                        </button>
            
                    </div>

                    <InquiryForm
                        slug={print.id}
                        title={print.data.title}
                    />
            
                )
            }

        </main>

    </div>

    <BottomNav />

    <script is:inline>

        const button = document.getElementById("show-form");
        const form = document.getElementById("inquiry-form");
        
        button?.addEventListener("click", () => {
        
            form.classList.add("open");
        
            button.remove();
        
        });
        
        form?.addEventListener("submit", async (event) => {
        
            event.preventDefault();
        
            const data = new FormData(form);
        
            const response = await fetch(form.action, {
        
                method: "POST",
        
                body: data,
        
            });
        
            if (response.ok) {
        
                form.innerHTML = `

    <div
        style="
            display:flex;
            flex-direction:column;
            gap:.75rem;
            padding:3rem 0;
        "
    >

    <p
    style="
        margin:0;
        font-size:1.5rem;
        color:var(--muted);
        line-height:1.6;
    "
>
    Thank you.
</p>

<p
    style="
        margin:0;
        font-size:1.5rem;
        color:var(--text);
        line-height:1.6;
    "
>
    I'll get back to you as soon as I can.
</p>

    </div>

`;
        
            }
        
            else {
        
                alert("Something went wrong. Please try again.");
        
            }
        
        });
        
        </script>

</Layout>

<style>

.print-layout {

    width: 45%;

    margin: 0 auto;

}

.print-header {

    margin-left: 0.6rem;

    display: flex;

    align-items: center;

    gap: 1.5rem;

    padding: 2rem 0 3rem;

}

.print-page {

    margin-bottom: 6rem;

}

.print-image {

    display: block;

    width: 100%;

    margin: 0 0 3rem;

}

.print-details {

    display: flex;

    flex-direction: column;

    gap: .75rem;

    font-size: 1.5rem;

    line-height: 1.8;

}

.print-details p {

    margin: 0;

}

.label {

    color: var(--muted);

    font-weight: 700;

    margin-right: .75rem;

}

.status-available {

    color: #4caf50;

}

.status-unavailable {

    color: var(--accent);

}

.print-actions {

    width: 100%;

    display: flex;

    justify-content: center;

    margin-top: 3rem;

}

.inquiry-form {

display: flex;

flex-direction: column;

gap: 2rem;

margin-top: 0;

max-height: 0;

opacity: 0;

overflow: hidden;

transform: translateY(-10px);

transition:
    max-height .45s ease,
    opacity .30s ease,
    transform .30s ease,
    margin-top .30s ease;

}

.inquiry-form.open {

margin-top: 3rem;

max-height: 1200px;

opacity: 1;

transform: translateY(0);

}

.form-group {

display: flex;

flex-direction: column;

gap: .6rem;

}

.form-label {

color: var(--muted);

font-weight: 700;

}

.print-actions .bracket-link {

appearance: none;
-webkit-appearance: none;

background: transparent;

border: none;

padding: 0;

margin: 0;

color: inherit;

font: inherit;

font-size: 2rem;

cursor: pointer;

}

.print-actions .bracket-link:hover {

color: var(--accent);

}

@media (max-width: 768px) {

    .print-layout {

        width: calc(100% - 2rem);

    }

    .print-actions .bracket-link {

        font-size: 1.8rem;

    }

    .print-header {

        margin-left: 0;

        flex-direction: column;

        align-items: flex-start;

        gap: .5rem;

        padding-bottom: 2rem;

    }

    .print-details {

        font-size: 1.2rem;

    }

}

</style>